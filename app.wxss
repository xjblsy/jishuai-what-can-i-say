page {
  font-family:
    -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #333;
  background-color: #f0f2f5;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 22rpx 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.25);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.btn-secondary {
  background: #f0f0f0;
  color: #333;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 22rpx 56rpx;
}

.btn-outline {
  background: transparent;
  color: #e94560;
  border: 2rpx solid #e94560;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 18rpx 44rpx;
  font-weight: 500;
}

.input-group {
  margin-bottom: 28rpx;
}

.input-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 14rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.25s;
}

.input-field:focus {
  border-color: #e94560;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(233, 69, 96, 0.06);
}

.textarea-field {
  width: 100%;
  min-height: 200rpx;
  background: #f5f7fa;
  border-radius: 14rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.25s;
}

.textarea-field:focus {
  border-color: #e94560;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(233, 69, 96, 0.06);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.8;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  line-height: 1.8;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(233, 69, 96, 0.08);
  color: #e94560;
}

.tag-secondary {
  background: rgba(26, 26, 46, 0.05);
  color: #555;
}

.tag-success {
  background: rgba(76, 175, 80, 0.08);
  color: #4caf50;
}

.tag-warning {
  background: rgba(255, 152, 0, 0.08);
  color: #ff9800;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

.fade-in {
  animation: fadeIn 0.35s ease-out both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.toast-success {
  color: #4caf50;
}

.toast-error {
  color: #e94560;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

.float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #e94560, #c23152);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.35);
  z-index: 100;
}

.float-btn .icon {
  font-size: 48rpx;
  color: #fff;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  padding: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  text-align: center;
  margin-bottom: 30rpx;
}

.swipe-delete {
  background: #e94560;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  font-size: 26rpx;
}
