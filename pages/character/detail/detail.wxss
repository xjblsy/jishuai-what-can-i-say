.detail-page {
  min-height: 100vh;
}

.detail-cover {
  background: linear-gradient(160deg, #1a1a2e, #16213e, #0f3460);
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.detail-avatar .avatar-img {
  width: 100%;
  height: 100%;
}

.detail-avatar .avatar-text {
  font-size: 56rpx;
  color: #fff;
  font-weight: 700;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.detail-nickname {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-bottom: 24rpx;
}

.detail-stats {
  display: flex;
  gap: 40rpx;
}

.detail-stat {
  text-align: center;
}

.detail-stat .stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.detail-stat .stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 4rpx;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.detail-action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.detail-action-btn.primary {
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #fff;
}

.detail-action-btn.secondary {
  background: #f0f0f0;
  color: #333;
}

/* 筛选区域 */
.filter-bar {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.filter-tag {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #eee;
  white-space: nowrap;
}

.filter-tag.active {
  background: #e94560;
  color: #fff;
  border-color: #e94560;
}

.sort-bar {
  display: flex;
  justify-content: flex-end;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
  gap: 24rpx;
}

.sort-item {
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 0;
}

.sort-item.active {
  color: #e94560;
  font-weight: 600;
}

.content-list {
  padding: 0 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.content-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.content-card .card-time {
  font-size: 22rpx;
  color: #bbb;
  margin-bottom: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.content-card .card-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.content-card .card-images {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.content-card .card-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.content-card .card-image .image {
  width: 100%;
  height: 100%;
}

.content-card .card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.content-card .card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.content-card .card-footer text {
  font-size: 24rpx;
  color: #bbb;
}

.content-card .card-footer .fav-active {
  color: #f2c94c;
}

.float-add-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #e94560, #c23152);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.35);
  z-index: 100;
}

.float-add-btn text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}
