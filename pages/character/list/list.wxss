.character-list-page {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

.search-bar {
  background: #fff;
  border-radius: 44rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-bar .search-icon {
  font-size: 32rpx;
  color: #bbb;
  margin-right: 12rpx;
}

.search-bar input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.character-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.character-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.character-card:active {
  transform: scale(0.96);
}

.character-card .card-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  overflow: hidden;
}

.character-card .card-avatar .avatar-img {
  width: 100%;
  height: 100%;
}

.character-card .card-avatar .avatar-text {
  font-size: 40rpx;
  color: #fff;
  font-weight: 600;
}

.character-card .card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 6rpx;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.character-card .card-nickname {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.character-card .card-count {
  font-size: 20rpx;
  color: #bbb;
  background: #f5f5f5;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.float-add-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #e94560, #c23152);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.35);
  z-index: 100;
}

.float-add-btn text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}

.list-view .character-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.list-view .item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.list-view .item-avatar .avatar-img {
  width: 100%;
  height: 100%;
}

.list-view .item-avatar .avatar-text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

.list-view .item-info {
  flex: 1;
  overflow: hidden;
}

.list-view .item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.list-view .item-nickname {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.list-view .item-count {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.list-view .item-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.view-toggle {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.view-toggle text {
  font-size: 36rpx;
  padding: 8rpx;
  color: #999;
  margin-left: 8rpx;
}

.view-toggle text.active {
  color: #e94560;
}
