.edit-page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
}

.avatar-picker {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.avatar-picker .avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-picker .avatar-placeholder {
  font-size: 60rpx;
  color: rgba(255, 255, 255, 0.7);
}

.avatar-picker .avatar-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-picker .avatar-overlay text {
  font-size: 20rpx;
  color: #fff;
}

.avatar-tip {
  font-size: 24rpx;
  color: #999;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-label .required {
  color: #e94560;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-input:focus {
  border-color: #e94560;
  background: #fff;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-textarea:focus {
  border-color: #e94560;
  background: #fff;
}

.char-counter {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.form-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.form-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.form-btn.primary {
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #fff;
}

.form-btn.secondary {
  background: #f0f0f0;
  color: #666;
}

.form-btn.danger {
  background: transparent;
  color: #e94560;
  border: 2rpx solid rgba(233, 69, 96, 0.3);
}

.delete-section {
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.delete-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #e94560;
  background: rgba(233, 69, 96, 0.06);
  border: 2rpx solid rgba(233, 69, 96, 0.2);
}
