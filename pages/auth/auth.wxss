.auth-page {
  min-height: 100vh;
  background: linear-gradient(
    170deg,
    #0a0a1a 0%,
    #12122a 30%,
    #1a1a2e 60%,
    #16213e 100%
  );
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.auth-page::before {
  content: "";
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(
    circle,
    rgba(233, 69, 96, 0.12) 0%,
    transparent 70%
  );
  border-radius: 50%;
  pointer-events: none;
}

.auth-page::after {
  content: "";
  position: absolute;
  bottom: -80rpx;
  left: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(
    circle,
    rgba(102, 126, 234, 0.08) 0%,
    transparent 70%
  );
  border-radius: 50%;
  pointer-events: none;
}

.auth-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 72rpx;
  z-index: 1;
}

.auth-logo {
  width: 170rpx;
  height: 170rpx;
  background: linear-gradient(135deg, #e94560, #c23152);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow:
    0 16rpx 48rpx rgba(233, 69, 96, 0.35),
    0 0 0 1rpx rgba(233, 69, 96, 0.1) inset;
}

.auth-logo .logo-icon {
  font-size: 76rpx;
  color: #fff;
  font-weight: 800;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.auth-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 10rpx;
  letter-spacing: 6rpx;
}

.auth-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 3rpx;
}

.auth-form {
  width: 100%;
  max-width: 600rpx;
  z-index: 1;
}

.password-input-wrapper {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 18rpx;
  padding: 14rpx 30rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s;
  margin-bottom: 44rpx;
}

.password-input-wrapper.focused {
  border-color: rgba(233, 69, 96, 0.6);
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 0 0 6rpx rgba(233, 69, 96, 0.06);
}

.password-input-wrapper .input-icon {
  font-size: 38rpx;
  margin-right: 18rpx;
}

.password-input {
  flex: 1;
  height: 84rpx;
  color: #fff;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.password-input::placeholder {
  color: rgba(255, 255, 255, 0.25);
}

.auth-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #e94560, #c23152);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 3rpx;
  box-shadow: 0 10rpx 30rpx rgba(233, 69, 96, 0.35);
  transition: all 0.3s;
}

.auth-btn:active {
  transform: scale(0.96);
  box-shadow: 0 6rpx 20rpx rgba(233, 69, 96, 0.25);
}

.auth-btn.disabled {
  opacity: 0.45;
}

.auth-error {
  color: #ff6b6b;
  font-size: 26rpx;
  text-align: center;
  margin-top: 28rpx;
  min-height: 36rpx;
  font-weight: 500;
}

.attempt-hint {
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
  text-align: center;
  margin-top: 24rpx;
}

.attempt-hint text {
  font-weight: 600;
  color: rgba(255, 152, 0, 0.8);
}

.auth-footer {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
}

.auth-footer text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
  letter-spacing: 2rpx;
}
