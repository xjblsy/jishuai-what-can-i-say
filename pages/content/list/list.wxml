<view class="list-page">
  <view class="filter-section">
    <view class="filter-row">
      <text class="filter-label">人物</text>
      <scroll-view class="character-selector" scroll-x>
        <text
          class="character-chip {{activeCharacter === '' ? 'active' : ''}}"
          bindtap="onFilterCharacter"
          data-id=""
        >全部</text>
        <text
          class="character-chip {{activeCharacter === item.id ? 'active' : ''}}"
          wx:for="{{characters}}"
          wx:key="id"
          bindtap="onFilterCharacter"
          data-id="{{item.id}}"
        >
          <view class="chip-avatar">
            <image
              wx:if="{{item.avatar}}"
              class="avatar-img"
              src="{{item.avatar}}"
              mode="aspectFill"
            />
            <text wx:else class="avatar-text">{{item.name[0]}}</text>
          </view>
          {{item.name}}
        </text>
      </scroll-view>
    </view>

    <view class="filter-row" wx:if="{{allTags.length > 0}}">
      <text class="filter-label">标签</text>
      <view class="filter-tags">
        <text
          class="filter-tag {{activeTag === '' ? 'active' : ''}}"
          bindtap="onFilterTag"
          data-tag=""
        >全部</text>
        <text
          class="filter-tag {{activeTag === item ? 'active' : ''}}"
          wx:for="{{allTags}}"
          wx:key="*this"
          bindtap="onFilterTag"
          data-tag="{{item}}"
        >{{item}}</text>
      </view>
    </view>
  </view>

  <view class="sort-row">
    <text class="result-count">共 {{filteredContents.length}} 条</text>
    <view class="sort-options">
      <text
        class="sort-option {{sortBy === 'time' ? 'active' : ''}}"
        bindtap="onSortChange"
        data-sort="time"
      >时间{{sortOrder === 'desc' ? '↓' : '↑'}}</text>
    </view>
  </view>

  <view wx:if="{{filteredContents.length > 0}}">
    <view
      class="content-card fade-in"
      wx:for="{{filteredContents}}"
      wx:key="id"
    >
      <view class="card-header" bindtap="onCharacterTap" data-id="{{item.characterId}}">
        <view class="header-avatar">
          <image
            wx:if="{{item.characterAvatar}}"
            class="avatar-img"
            src="{{item.characterAvatar}}"
            mode="aspectFill"
          />
          <text wx:else class="avatar-text">{{item.characterName[0]}}</text>
        </view>
        <text class="header-name">{{item.characterName}}</text>
        <text class="header-time">{{item.formattedTime}}</text>
      </view>

      <view class="card-text" wx:if="{{item.text}}">{{item.text}}</view>

      <view class="card-images" wx:if="{{item.images && item.images.length > 0}}">
        <view
          class="card-image"
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="*this"
          catchtap="onPreviewImage"
          data-urls="{{item.images}}"
          data-current="{{index}}"
        >
          <image class="image" src="{{img}}" mode="aspectFill" />
        </view>
      </view>

      <view class="card-tags" wx:if="{{item.tags && item.tags.length > 0}}">
        <text class="tag tag-primary" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="card-footer">
        <text
          class="{{item.isFavorite ? 'fav-active' : ''}}"
          bindtap="onToggleFavorite"
          data-id="{{item.id}}"
        >{{item.isFavorite ? '⭐' : '☆'}} 收藏</text>
        <text bindtap="onEditContent" data-id="{{item.id}}" data-character-id="{{item.characterId}}">编辑</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">📝</text>
    <text class="empty-text">暂无匹配的语录内容</text>
  </view>
</view>