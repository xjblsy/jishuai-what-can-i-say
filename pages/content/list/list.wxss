.list-page {
  padding: 24rpx;
  padding-bottom: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.filter-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 26rpx;
  color: #666;
  width: 80rpx;
  flex-shrink: 0;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.filter-tag {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: #f5f5f5;
  color: #666;
}

.filter-tag.active {
  background: #e94560;
  color: #fff;
}

.character-selector {
  display: flex;
  gap: 12rpx;
  flex: 1;
  overflow-x: auto;
}

.character-selector::-webkit-scrollbar {
  display: none;
}

.character-chip {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: #f5f5f5;
  color: #666;
  white-space: nowrap;
  flex-shrink: 0;
}

.character-chip.active {
  background: #667eea;
  color: #fff;
}

.character-chip .chip-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: #ddd;
  overflow: hidden;
}

.character-chip .chip-avatar .avatar-img {
  width: 100%;
  height: 100%;
}

.character-chip .chip-avatar .avatar-text {
  font-size: 18rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.sort-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-count {
  font-size: 24rpx;
  color: #999;
}

.sort-options {
  display: flex;
  gap: 20rpx;
}

.sort-option {
  font-size: 24rpx;
  color: #999;
}

.sort-option.active {
  color: #e94560;
}

.content-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-header .header-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.card-header .header-avatar .avatar-img {
  width: 100%;
  height: 100%;
}

.card-header .header-avatar .avatar-text {
  font-size: 24rpx;
  color: #fff;
}

.card-header .header-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
}

.card-header .header-time {
  font-size: 22rpx;
  color: #bbb;
}

.card-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.card-images {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.card-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.card-image .image {
  width: 100%;
  height: 100%;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.card-footer text {
  font-size: 24rpx;
  color: #bbb;
}

.card-footer .fav-active {
  color: #f2c94c;
}
