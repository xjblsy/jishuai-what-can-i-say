<wxs module="wxs" src="./edit.wxs" />
<view class="edit-page">
  <view class="empty-character-hint" wx:if="{{!isEdit && characters.length === 0}}">
    <text class="hint-icon">👤</text>
    <text class="hint-text">请先添加人物，才能记录语录哦</text>
    <view class="hint-btn" bindtap="onCreateCharacter">去添加人物</view>
  </view>

  <block wx:if="{{isEdit || characters.length > 0}}">
    <view class="character-selector-area" wx:if="{{!isEdit}}">
      <text class="selector-label">选择人物</text>
      <view class="character-picker" bindtap="onShowCharacterPicker">
        <view class="picker-avatar">
          <image
            wx:if="{{selectedCharacter.avatar}}"
            class="avatar-img"
            src="{{selectedCharacter.avatar}}"
            mode="aspectFill"
          />
          <text wx:else class="avatar-text">{{selectedCharacter.name ? selectedCharacter.name[0] : '?'}}</text>
        </view>
        <text class="picker-name" wx:if="{{selectedCharacter.name}}">{{selectedCharacter.name}}</text>
        <text class="picker-placeholder" wx:else>请选择人物</text>
        <text class="picker-arrow">›</text>
      </view>
    </view>

    <view class="content-section">
      <textarea
        class="content-textarea"
        placeholder="请输入精彩言论..."
        value="{{text}}"
        bindinput="onTextInput"
        maxlength="{{maxTextLength}}"
        auto-height
      />
      <view class="text-char-count">{{text.length}}/{{maxTextLength}}</view>
    </view>

    <view class="images-section">
      <text class="section-label">照片（选填）</text>
      <view class="image-grid">
        <view
          class="image-item"
          wx:for="{{images}}"
          wx:key="*this"
        >
          <image class="image" src="{{item}}" mode="aspectFill" catchtap="onPreviewImage" data-url="{{item}}" />
          <view class="delete-btn" catchtap="onRemoveImage" data-index="{{index}}">
            <text>✕</text>
          </view>
        </view>

        <view class="add-image-btn" wx:if="{{images.length < maxImages}}" bindtap="onAddImage">
          <text class="add-icon">+</text>
          <text class="add-text">{{images.length}}/{{maxImages}}</text>
        </view>
      </view>
    </view>

    <view class="tags-section">
      <text class="section-label">分类标签（选填）</text>
      <view class="tags-wrapper">
        <text
          class="tag-item {{wxs.isTagSelected(selectedTags, item) ? 'selected' : ''}}"
          wx:for="{{defaultTags}}"
          wx:key="*this"
          bindtap="onToggleTag"
          data-tag="{{item}}"
        >{{item}}</text>
        <text
          class="tag-item {{wxs.isTagSelected(selectedTags, item) ? 'selected' : ''}}"
           wx:for="{{customTags}}"
          wx:key="*this"
          bindtap="onToggleTag"
          data-tag="{{item}}"
        >{{item}}</text>
        <input
          class="custom-tag-input"
          placeholder="自定义标签"
          value="{{customTagInput}}"
          bindinput="onCustomTagInput"
          bindconfirm="onAddCustomTag"
          maxlength="15"
          confirm-type="done"
        />
      </view>
    </view>
  </block>
</view>

<view class="action-bar" wx:if="{{isEdit || characters.length > 0}}">
  <view class="action-btn preview" bindtap="onPreview">预览</view>
  <view class="action-btn primary" bindtap="onSubmit">提交</view>
</view>

<view class="preview-overlay" wx:if="{{showPreview}}" catchtouchmove="noop">
  <view class="preview-header">
    <view class="close-btn" bindtap="onClosePreview">
      <text>✕</text>
    </view>
    <view class="confirm-btn" bindtap="onConfirmSubmit">确认提交</view>
  </view>
  <scroll-view class="preview-body" scroll-y>
    <view class="preview-card">
      <view class="preview-character">
        <view class="pc-avatar">
          <image
            wx:if="{{selectedCharacter.avatar}}"
            class="avatar-img"
            src="{{selectedCharacter.avatar}}"
            mode="aspectFill"
          />
          <text wx:else class="avatar-text">{{selectedCharacter.name ? selectedCharacter.name[0] : '?'}}</text>
        </view>
        <text class="pc-name">{{selectedCharacter.name || '未选择'}}</text>
      </view>

      <view class="preview-text">{{text || '（无文字内容）'}}</view>

      <view class="preview-images" wx:if="{{images.length > 0}}">
        <view class="preview-image" wx:for="{{images}}" wx:key="*this">
          <image class="image" src="{{item}}" mode="aspectFill" />
        </view>
      </view>

      <view class="preview-tags" wx:if="{{selectedTags.length > 0}}">
        <text class="tag tag-primary" wx:for="{{selectedTags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </scroll-view>
</view>

<view class="modal-overlay" wx:if="{{showCharacterPicker}}" catchtouchmove="noop">
  <view class="modal-content">
    <view class="modal-title">选择人物</view>
    <view
      class="picker-character-item {{selectedCharacter.id === item.id ? 'selected' : ''}}"
      wx:for="{{characters}}"
      wx:key="id"
      bindtap="onSelectCharacter"
      data-character="{{item}}"
    >
      <view class="picker-char-avatar">
        <image
          wx:if="{{item.avatar}}"
          class="avatar-img"
          src="{{item.avatar}}"
          mode="aspectFill"
        />
        <text wx:else class="avatar-text">{{item.name[0]}}</text>
      </view>
      <view class="picker-char-info">
        <text class="picker-char-name">{{item.name}}</text>
        <text wx:if="{{item.nickname}}" class="picker-char-nickname">@{{item.nickname}}</text>
      </view>
      <text wx:if="{{selectedCharacter.id === item.id}}" class="picker-char-check">✓</text>
    </view>
    <view class="picker-cancel-wrapper">
      <text class="picker-cancel-btn" bindtap="onCloseCharacterPicker">取消</text>
    </view>
  </view>
</view>