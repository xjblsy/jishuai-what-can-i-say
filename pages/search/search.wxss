.search-page {
  min-height: 100vh;
}

.search-bar-area {
  padding: 20rpx 24rpx;
  background: #fff;
}

.search-input-wrapper {
  background: #f5f5f5;
  border-radius: 44rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
}

.search-input-wrapper .search-icon {
  font-size: 32rpx;
  color: #bbb;
  margin-right: 12rpx;
}

.search-input-wrapper input {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
}

.search-input-wrapper .clear-btn {
  font-size: 32rpx;
  color: #bbb;
  padding: 8rpx;
}

.search-tips {
  padding: 28rpx;
}

.search-tips .tips-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-tag-item {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  background: #f0f0f0;
  color: #555;
}

.hot-tag-item:active {
  background: #e94560;
  color: #fff;
}

.result-info {
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: #999;
}

.result-list {
  padding: 0 24rpx;
  padding-bottom: 40rpx;
}

.result-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.result-item .item-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-item .item-header .header-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.result-item .item-header .header-avatar .avatar-img {
  width: 100%;
  height: 100%;
}

.result-item .item-header .header-avatar .avatar-text {
  font-size: 24rpx;
  color: #fff;
}

.result-item .item-header .header-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
}

.result-item .item-header .header-time {
  font-size: 22rpx;
  color: #bbb;
}

.result-item .item-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.result-item .item-text .highlight {
  color: #e94560;
  font-weight: 600;
}

.result-item .item-images {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.result-item .item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.result-item .item-image .image {
  width: 100%;
  height: 100%;
}

.result-item .item-tags {
  display: flex;
  flex-wrap: wrap;
}

.character-results {
  margin-bottom: 28rpx;
}

.char-result-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.char-result-item .char-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.char-result-item .char-avatar .avatar-img {
  width: 100%;
  height: 100%;
}

.char-result-item .char-avatar .avatar-text {
  font-size: 30rpx;
  color: #fff;
}

.char-result-item .char-info {
  flex: 1;
}

.char-result-item .char-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.char-result-item .char-name .highlight {
  color: #e94560;
}

.char-result-item .char-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.section-divider {
  height: 1rpx;
  background: #eee;
  margin: 16rpx 28rpx;
}

.no-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.no-result .no-result-icon {
  font-size: 80rpx;
  color: #ddd;
  margin-bottom: 20rpx;
}

.no-result .no-result-text {
  font-size: 28rpx;
  color: #999;
}
